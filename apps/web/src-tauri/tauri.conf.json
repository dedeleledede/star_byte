{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "star_byte",
  "version": "0.1.0",
  "identifier": "com.zavan.starbyte",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "star_byte",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCMzUwNTY3MjdBNzZCMjAKUldRZ2E2Y25ad1UxUzdVeG10Q29GektCb1NCM2M5Y0dVRnJjTXpvWGxUQ29mUFlER1lua3NodEgK",
      "endpoints": [
        "https://constellation.servebeer.com/api/desktop/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
