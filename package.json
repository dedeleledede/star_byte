{
  "name": "star-byte",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @starbyte/server\" \"npm run dev -w @starbyte/web\"",
    "dev:server": "npm run dev -w @starbyte/server",
    "dev:web": "npm run dev -w @starbyte/web",
    "build": "npm run build -w @starbyte/server && npm run build -w @starbyte/web",
    "test": "node --test scripts/*.test.mjs && npm run test -w @starbyte/server",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "release:status": "node deploy/release/publish-from-github.mjs --status"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
